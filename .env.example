# Read directly by this app's code:
BACKBOARD_API_KEY=
GEMINI_API_KEY=
GEMINI_ACTION_MODEL=gemini-3.5-flash-lite
# Backboard's optional high-level planner; not used per movement.
# Preferred routes; exhausted quotas switch to the fallback for this session.
BACKBOARD_PROVIDER=google
BACKBOARD_MODEL=gemini-3.6-flash
BACKBOARD_FALLBACK_PROVIDER=openai
BACKBOARD_FALLBACK_MODEL=gpt-4.1-mini
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_VISION_FALLBACK_MODEL=gemini-3.5-flash-lite
# Minimum seconds between vision request starts (10 requests/minute by default).
VISION_MIN_INTERVAL_S=6
BASETEN_API_KEY=
BASETEN_STT_MODEL_ID=
BASETEN_PARSER_MODEL_ID=
ELEVENLABS_API_KEY=
VOICE_ID=
