# Read directly by this app's code:
BACKBOARD_API_KEY=
BASETEN_API_KEY=
BASETEN_STT_MODEL_ID=
BASETEN_PARSER_MODEL_ID=
ELEVENLABS_API_KEY=
VOICE_ID=

# Camera bridge (Pi -> laptop depth server over Wi-Fi):
DEPTH_SERVER_HOST=          # laptop IP on the hotspot (e.g. 172.20.10.3)
DEPTH_SERVER_PORT=8765

# MongoDB (mission tracking — transcripts, brain activity, findings, sensors):
MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=

# Motor driver (RoboMaster EP Core SDK — teammate implementing):
# MOTOR_* vars TBD based on RoboMaster SDK

# GPS (USB or UART serial):
# GPS_DEVICE=/dev/ttyUSB0
# GPS_BAUD=4800

# Temperature sensor (DS18B20 1-Wire or DHT22):
# DS18B20_PATH=/sys/bus/w1/devices/28-*/w1_slave
# DHT22_PIN=4

# IMU (MPU6050 on I2C):
# MPU6050_BUS=1
# MPU6050_ADDR=0x68

# USB webcam (Pi capture):
# VIDEO_DEVICE=/dev/video0
# AUDIO_DEVICE=default

# NOT read by this app -- Gemini vision is routed through Backboard (BYOK). Get
# GEMINI_API_KEY and connect it in the Backboard dashboard's provider settings, not here.
# (VERIFY exact dashboard flow -- undocumented in the Backboard API docs, see
# BUILD_PLAN.md.)
