# Read directly by this app's code:
BACKBOARD_API_KEY=
OPENAI_API_KEY=
BACKBOARD_PROVIDER=openai
BACKBOARD_MODEL=gpt-4.1
# No automatic model switch; leave the fallback model empty to stay on GPT-4.1.
BACKBOARD_FALLBACK_PROVIDER=openai
BACKBOARD_FALLBACK_MODEL=
OPENAI_VISION_MODEL=gpt-4.1
# Minimum seconds between vision request starts (10 requests/minute by default).
VISION_MIN_INTERVAL_S=6
BASETEN_API_KEY=
BASETEN_STT_MODEL_ID=
BASETEN_PARSER_MODEL_ID=
ELEVENLABS_API_KEY=
VOICE_ID=
